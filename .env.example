# Copia este fichero como .env y ajusta los valores. El .env real no se sube al repositorio.

# PostgreSQL (metadatos)
DATABASE_URL=postgresql+psycopg://files:cambia-esta-clave@localhost:5432/files

# MinIO / S3 (contenido binario)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=cambia-este-usuario
S3_SECRET_KEY=cambia-esta-clave
S3_BUCKET=files
S3_REGION=us-east-1
S3_AUTO_CREATE_BUCKET=true

# Reglas de validación
MAX_UPLOAD_SIZE=104857600
# Lista separada por comas; vacío = cualquier tipo. Ej.: application/pdf,image/png,image/jpeg
ALLOWED_CONTENT_TYPES=
MAX_FILENAME_LENGTH=255

# Sólo para docker-compose (servicios de desarrollo)
POSTGRES_USER=files
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=files
MINIO_ROOT_USER=cambia-este-usuario
MINIO_ROOT_PASSWORD=cambia-esta-clave

# Puertos publicados en el host por docker-compose (opcionales)
API_PORT=8000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
